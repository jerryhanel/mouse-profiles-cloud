{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_MYSQL_HOST;Database=mouseprofilescloud;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS_LONG",
    "Issuer": "MouseProfilesCloud",
    "Audience": "MouseProfilesCloudUsers"
  },
  "Brevo": {
    "ApiKey": "YOUR_BREVO_API_KEY",
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "MouseProfiles Cloud"
  },
  "App": {
    "BaseUrl": "https://localhost:5001"
  }
}
